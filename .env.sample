OPENAI_MODEL=<openai_model>
OPENAI_BASE_URL=<openai_base_url>
OPENAI_API_KEY=<openai_api_key>

# Credentials used by the application to access the local LiteLLM proxy.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_MODEL=smartphone-chat
LITELLM_EMBEDDINGS_MODEL=smartphone-embeddings
LITELLM_API_KEY=<litellm_virtual_key>

# Credentials used to administer the LiteLLM proxy. Generate strong random values.
LITELLM_MASTER_KEY=<sk-prefixed-master-key>
LITELLM_SALT_KEY=<long-random-salt-key>

LANGFUSE_SECRET_KEY=<langfuse_secret_key>
LANGFUSE_PUBLIC_KEY=<langfuse_public_key>
LANGFUSE_HOST=<langfuse_host>

REDIS_CONNECTION_STRING=<redis_connection_url>
