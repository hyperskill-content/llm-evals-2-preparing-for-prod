# LiteLLM proxy (Task 4). The app only holds a virtual key; the real provider
# API key lives in litellm/.env. scripts/setup_litellm.py fills these in.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=<litellm_virtual_key>
LITELLM_MODEL=gpt-4o-mini
LITELLM_EMBEDDINGS_MODEL=text-embedding-ada-002

# Langfuse tracing and prompt management
LANGFUSE_SECRET_KEY=<langfuse_secret_key>
LANGFUSE_PUBLIC_KEY=<langfuse_public_key>
LANGFUSE_HOST=<langfuse_host>

# Redis for chat history (Task 2), e.g. redis://localhost:6380/0
REDIS_URL=<redis_url>
