# Chat model and embeddings model (OpenAI or an OpenAI-compatible endpoint)
OPENAI_MODEL=<openai_model>
OPENAI_EMBEDDINGS_MODEL=<openai_embeddings_model>
OPENAI_BASE_URL=<openai_base_url>
OPENAI_API_KEY=<openai_api_key>

# Langfuse tracing and prompt management
LANGFUSE_SECRET_KEY=<langfuse_secret_key>
LANGFUSE_PUBLIC_KEY=<langfuse_public_key>
LANGFUSE_HOST=<langfuse_host>

# Redis for chat history (Task 2), e.g. redis://localhost:6380/0
REDIS_URL=<redis_url>
