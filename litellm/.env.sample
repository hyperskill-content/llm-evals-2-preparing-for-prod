# Copy to litellm/.env (git-ignored) and fill in. Read by docker-compose.yml for the LiteLLM container.

# Admin key for the proxy and password for the admin UI (user: admin). Must start with sk-
LITELLM_MASTER_KEY=sk-<random_string>
# Encrypts provider keys stored in the proxy's database. Don't change it after first start.
LITELLM_SALT_KEY=sk-<random_string>

# Your real model provider. The app no longer uses these; it talks to the proxy with a virtual key.
UPSTREAM_OPENAI_BASE_URL=<real_provider_base_url>
UPSTREAM_OPENAI_API_KEY=<real_provider_api_key>
