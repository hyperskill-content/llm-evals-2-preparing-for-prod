# Secrets for the LiteLLM proxy (copy to litellm/.env; never commit litellm/.env)

# Real provider credentials. Only the proxy holds these; the app uses a
# LiteLLM virtual key instead.
OPENAI_API_KEY=<openai_api_key>
OPENAI_BASE_URL=<openai_base_url>

# Admin key for the proxy and its UI. Must start with "sk-".
LITELLM_MASTER_KEY=<sk-long-random-string>

# Encrypts provider keys stored in the database. Use a long random value and
# never change it after the first start, or stored keys cannot be decrypted.
LITELLM_SALT_KEY=<long_random_string>

# Password for the proxy's Postgres database
POSTGRES_PASSWORD=<long_random_string>
